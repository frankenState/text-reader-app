{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Voice",
  "version": "1.0.1",
  "identifier": "com.localvoice.desktop",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Local Voice",
        "url": "index.html",
        "width": 1180,
        "height": 880,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "sidecar/**/*",
      "models/**/*"
    ],
    "shortDescription": "Offline text to speech",
    "longDescription": "Reads text aloud with 54 built-in voices. The Kokoro-82M model runs on your own CPU, so nothing is uploaded and there is no character limit.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
